# Copy to .env for local development. On Posit Connect set these under
# Content Settings → Vars instead (never deploy the .env file).

# ---- Runtime -------------------------------------------------------------
# production (default) | development. Dash debug is only possible in development.
LDT_ENV=production
DASH_DEBUG=0
PORT=8050
LDT_LOG_LEVEL=INFO

# ---- Azure Databricks (OAuth service principal for prd_mega.sgpbpi163) --------
DATABRICKS_SERVER_HOSTNAME=adb-0000000000000000.0.azuredatabricks.net
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/0000000000000000
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=
DATABRICKS_QUERY_TIMEOUT_SECONDS=120

LDT_CATALOG=prd_mega
LDT_SCHEMA=sgpbpi163
LDT_DOCUMENTS_VOLUME=/Volumes/prd_mega/sgpbpi163/vgpbpi163/LDT/Local Development Plans

# ---- Table overrides (optional; defaults live in constants.py) -------------
# LDT_<ISO3>_INDICATORS_TABLE / _SCORES_TABLE / _BOUNDARIES_TABLE per country.
# LDT_NPL_SCORES_TABLE=ldt_npl_admin2_scores
# LDT_VNM_BOUNDARIES_TABLE=ldt_vnm_admin2_boundaries
# LDT_PLAN_SOURCES_TABLE=ldt_plan_document_sources
# LDT_STRATEGY_INVENTORY_TABLE=ldt_strategy_inventory_documents
# LDT_AI_STAGE_CACHE_TABLE=ldt_ai_stage_cache

# ---- Data artifacts -----------------------------------------------------
# LDT_CACHE_DIR=.ldt_cache
# LDT_SNAPSHOT_DIR=data_snapshot
LDT_DATA_MAX_AGE_SECONDS=43200
LDT_WARM_RETRY_COOLDOWN_SECONDS=600
LDT_DISABLE_BG_WARM=0
LDT_FORCE_WARM_ON_START=0

# Long random strings (e.g. python -c "import secrets; print(secrets.token_urlsafe(32))").
# REFRESH: POST /api/admin/refresh and detailed /healthz. PREVIEW: /api/preview?token=… unlocks preview countries.
LDT_REFRESH_TOKEN=
LDT_PREVIEW_TOKEN=

# ---- Security -----------------------------------------------------------
# Comma-separated extra origins allowed to call /api/* cross-origin (same origin always works).
LDT_ALLOWED_ORIGINS=
LDT_API_RATE_LIMIT_PER_MINUTE=120

# ---- AI planning brief (Posit mAI Gateway) -------------------------------
MAI_BASE_URL=
MAI_ENDPOINT=
MAI_MODEL=


